# Copy to .env and adjust. All vars are prefixed UMBRA_.

# --- Tor (run the Tor daemon separately; this is just the SOCKS port) ---
# Set UMBRA_USE_TOR=false to fetch directly (clearnet-only test/demo runs,
# no Tor daemon needed). Keep it true for real dark-web crawling.
UMBRA_USE_TOR=true
UMBRA_TOR_SOCKS_HOST=127.0.0.1
UMBRA_TOR_SOCKS_PORT=9050

# --- Storage ---
# Dev (default): local SQLite file
# Default: a per-user data directory (%LOCALAPPDATA%MbraMbra.db on Windows).
# UMBRA_DATABASE_URL=sqlite+aiosqlite:///path/to/umbra.db
# Prod example:
# UMBRA_DATABASE_URL=postgresql+asyncpg://umbra:secret@localhost:5432/umbra

# --- Crawl ---
UMBRA_MAX_WORKERS=8
UMBRA_MAX_PAGES=500
UMBRA_MAX_DEPTH=5
UMBRA_MAX_PAGES_PER_DOMAIN=25
UMBRA_ALLOW_CLEARNET=false

# --- Focused crawling (leave empty for breadth-first) ---
# UMBRA_FOCUS_KEYWORDS=["market","vendor","leak"]

# --- Compliance ---
UMBRA_STORE_TEXT=true
UMBRA_STORE_HTML=false
UMBRA_STORE_MEDIA=false
# Operator-supplied "category:regex" rules; matched pages have content discarded.
# UMBRA_BLOCKLIST_PATH=./blocklist.example.txt
# Known-bad content SHA-256 list (CSAM/malware); matched pages are dropped.
# UMBRA_KNOWN_BAD_HASHES_PATH=./known_bad_hashes.txt
# Data retention: purge pages older than N days via `umbra purge` (0 = keep forever).
UMBRA_RETENTION_DAYS=0

# --- Embeddings ---
# hashing (offline, zero-setup) | local (real semantic; pip install -e ".[embeddings]")
UMBRA_EMBEDDER_KIND=hashing

UMBRA_LOG_LEVEL=INFO
